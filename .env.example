# ========================================================
# Shopark 运行环境配置文件模板 (.env)
# 首次运行前请复制为 .env 并根据实际情况修改安全密钥
# cp .env.example .env
# ========================================================

# --------------------------------------------------------
# 镜像源与版本配置
# --------------------------------------------------------
# 国内环境推荐使用阿里云公开镜像源（无需翻墙，高速拉取）：
# SHOPARK_IMAGE_REGISTRY=crpi-vvvid8bdlzbcxo4s.cn-shenzhen.personal.cr.aliyuncs.com
# 海外环境推荐使用 GitHub Container Registry：
# SHOPARK_IMAGE_REGISTRY=ghcr.io
SHOPARK_IMAGE_REGISTRY=crpi-vvvid8bdlzbcxo4s.cn-shenzhen.personal.cr.aliyuncs.com
SHOPARK_IMAGE_NAME=hoxiai/shopark
SHOPARK_VERSION=latest

# 宿主机映射对外暴露端口 (默认 5490)
SHOPARK_HTTP_PORT=5490

# --------------------------------------------------------
# 站点与初始管理员账户 (仅首次初始化数据库时生效)
# --------------------------------------------------------
SHOPARK_STORE_NAME=Shopark Store
# 访问 URL，生产部署请填写实际完整域名（例如 https://demo.myshopark.com）
SHOPARK_SITE_URL=http://localhost:5490
# 初始超级管理员登录邮箱
SHOPARK_SITE_EMAIL=admin@shopark.ai
# 初始超级管理员密码（必填，至少 8 位；./shopark.sh init 会自动生成）
SHOPARK_SITE_PASSWORD=

# --------------------------------------------------------
# 安全与 JWT 签名密钥 (生产环境务必更改为随机高强度字符串)
# --------------------------------------------------------
# 签名密钥 (必填，至少 16 位；可用 openssl rand -hex 16 生成)
SHOPARK_JWT_SIGN_KEY=
# 加密私钥 (必填；可用 openssl rand -hex 16 生成)
SHOPARK_JWT_SECRET_KEY=
SHOPARK_JWT_ADMIN_PERMISSION_MODE=enforce

# --------------------------------------------------------
# 数据库配置 (内置 MySQL 服务)
# --------------------------------------------------------
SHOPARK_DB_DRIVER=mysql
SHOPARK_DB_HOST=mysql
SHOPARK_DB_PORT=3306
SHOPARK_DB_DATABASE=shopark
SHOPARK_DB_USERNAME=shopark
# MySQL 普通用户密码（请修改）
SHOPARK_DB_PASSWORD=shopark_db_password_change_me
# PostgreSQL SSL 模式（可选：disable / require / verify-ca / verify-full）
SHOPARK_DB_SSLMODE=
# MySQL Root 管理员密码（请修改）
SHOPARK_MYSQL_ROOT_PASSWORD=shopark_mysql_root_password_change_me

# --------------------------------------------------------
# 缓存配置 (内置 Redis 服务)
# --------------------------------------------------------
SHOPARK_REDIS_ADDR=redis:6379
# Redis 访问密码（请修改）
SHOPARK_REDIS_PASSWORD=shopark_redis_password_change_me
SHOPARK_REDIS_DB=0

# --------------------------------------------------------
# 官方应用与主题市场配置 (官方服务与扩展接口)
# --------------------------------------------------------
SHOPARK_OFFICIAL_API_URL=https://hoxi.dev
SHOPARK_REGISTRY_URL=https://hoxi.dev
